# ==============================================================================
# thanglish.py — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="thanglish.py"

# Secret Key for JWT Token Signing (Generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_64_char_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary MySQL Database Connection URL
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/thanglish_db

# Frontend Origin URL (for CORS validation)
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 / OpenID Connect Configuration
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# GitHub OAuth App Configuration
# Create credentials in GitHub Settings: https://github.com/settings/developers
# Authorized callback URL: http://localhost:3000/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# Optional AI Translation Provider API Key
AI_TRANSLATION_API_KEY=
